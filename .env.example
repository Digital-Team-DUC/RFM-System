# ==============================================================================
# REAL ESTATE & FINANCIAL MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development | staging | production)
NODE_ENV=development

# Timezone & Regional Defaults (Cambodia Defaults)
TZ=Asia/Phnom_Penh
DEFAULT_CURRENCY=USD
SECONDARY_CURRENCY=KHR
KHR_EXCHANGE_RATE=4100.00

# Backend Configuration
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0
BACKEND_API_PREFIX=/api/v1
BACKEND_URL=http://localhost:4000

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000

# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=rfm_user
DATABASE_PASSWORD=rfm_secure_password_2026
DATABASE_NAME=rfm_db
DATABASE_URL="postgresql://rfm_user:rfm_secure_password_2026@localhost:5432/rfm_db?schema=public"

# Redis Configuration (Job queue & cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Security
JWT_ACCESS_SECRET=rfm_enterprise_jwt_access_super_secret_key_2026_xyz!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=rfm_enterprise_jwt_refresh_super_secret_key_2026_xyz!
JWT_REFRESH_EXPIRATION=7d
ARGON_MEMORY_COST=65536

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# File Upload & Storage Settings (local | s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=rfm-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Notification Providers (Optional - marked unconfigured if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@rfm-system.com

TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
