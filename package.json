{
  "name": "rfm-system-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Real Estate & Financial Management System",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "backend:dev": "npm run start:dev --workspace=backend",
    "backend:build": "npm run build --workspace=backend",
    "frontend:dev": "npm run dev --workspace=frontend",
    "frontend:build": "npm run build --workspace=frontend",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=backend",
    "prisma:seed": "npm run prisma:seed --workspace=backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build"
  },
  "keywords": [
    "real-estate",
    "erp",
    "financial-management",
    "double-entry-accounting",
    "nestjs",
    "react",
    "postgresql",
    "prisma"
  ],
  "author": "RFM Enterprise Systems Team",
  "license": "Proprietary"
}
